# Скопируйте этот файл в .env и при необходимости измените значения.
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Доверенные домены для CSRF (обязательно для HTTPS / хостинг)
# Добавьте ваш домен через запятую, всегда со схемой (https://)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Подключение к БД. По умолчанию используется SQLite (db.sqlite3 в корне проекта).
# Чтобы переключиться на PostgreSQL — раскомментируйте строки ниже и заполните параметры.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=pcshop
# DB_USER=pcshop
# DB_PASSWORD=pcshop
# DB_HOST=127.0.0.1
# DB_PORT=5432
